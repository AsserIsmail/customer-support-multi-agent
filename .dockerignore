!pyproject.toml
!requirements-lock.txt
!README.md
!streamlit_app.py
!src/
!src/**
!tests/
!tests/**
!.streamlit/
!.streamlit/config.toml
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.env
**/.env.*
**/secrets.toml
