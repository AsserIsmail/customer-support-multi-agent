# Loaded from the working directory; process environment takes precedence.
SUPPORT_DB_PATH=data/support.db
SUPPORT_LOG_LEVEL=INFO
# Set locally; never paste keys into chat or commit this file with a real key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
AGENT_TIMEOUT_SECONDS=60
API_HOST=127.0.0.1
API_PORT=8000
SUPPORT_API_URL=http://127.0.0.1:8000
API_CHAT_TIMEOUT_SECONDS=300
API_SESSION_TTL_SECONDS=3600
API_MAX_SESSIONS=100
# Docker uses separate host ports so it can coexist with the native app.
DOCKER_API_PORT=18000
DOCKER_UI_PORT=18501
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=company_policies
POLICY_CHUNK_SIZE=1200
POLICY_CHUNK_OVERLAP=200
POLICY_MAX_DISTANCE=0.6
